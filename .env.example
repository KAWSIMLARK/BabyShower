# Supabase — trouvés dans Project Settings > API sur supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publique du site (utilisée pour la redirection du lien magique et le SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Liste des courriels autorisés à accéder à /admin, séparés par des virgules
ADMIN_EMAILS=ton-courriel@exemple.com
